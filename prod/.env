# -------------------------
# General (non-sensitive)
# -------------------------
COMPOSE_PROJECT_NAME=n8nstack   #environment variable in Docker Compose used to define the project name for a set of Docker services
TZ=Asia/Kolkata                         # timezone for containers (set to your preferred timezone)
N8N_HOSTNAME=n8n.automatestack.dev    # <-- Replace with your public domain (used for WEBHOOK_URL & Traefik rule)
LETSENCRYPT_EMAIL=sumit12590@gmail.com

# -------------------------
# Postgres settings (non-sensitive)
# -------------------------
# NOTE: DB_POSTGRESDB_PASSWORD should be stored as a Docker secret (pg_password).
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8nuser
DB_POSTGRESDB_PASSWORD=pgcloud

# -------------------------
# n8n auth / behavior
# -------------------------
N8N_BASIC_AUTH_PASSWORD=n8ncloud
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin

# Optional metrics/queue settings
N8N_METRICS=true
N8N_METRICS_INCLUDE_QUEUE_METRICS=true

# Queue workers (optional)
#N8N_WORKERS_COUNT=1

# -------------------------
# Resource & tuning (example values)
# -------------------------
# These are suggestions; tune for your server hardware
# For Postgres: max connections ≈ (typical) 100 (adjust in postgres.conf if needed)
DB_POOL_SIZE=20

# -------------------------
# Notes on secrets:
# - Create docker secrets named: pg_password, n8n_basic_pass
# - The compose file references them and the containers access them via *_FILE env variables
